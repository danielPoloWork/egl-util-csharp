<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Domain\It.D4np.Util.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="MediatR" Version="12.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Bundled into the single It.D4np.Util package via the Infrastructure project; not published on its own. -->
    <IsPackable>false</IsPackable>
    <Description>Application-layer building blocks for egl-util-csharp: domain-event notifications onto MediatR and a FluentValidation pipeline behavior.</Description>
  </PropertyGroup>

</Project>
