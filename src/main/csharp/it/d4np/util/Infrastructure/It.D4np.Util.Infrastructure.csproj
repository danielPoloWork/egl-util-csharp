<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This is the single packable project. The It.D4np.Util NuGet package bundles the Domain and
    Application assemblies (below, via PrivateAssets=all + the IncludeReferencedProjectsInPackage
    target) alongside Infrastructure, so consumers get all three layers from one package. Every
    third-party dependency of all three layers is declared directly here, so the package's dependency
    list is complete even though the referenced projects flow no transitive package assets.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Application\It.D4np.Util.Application.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Domain\It.D4np.Util.Domain.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.28" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Infrastructure building blocks for egl-util-csharp: EF Core specification evaluation, domain-event dispatch around SaveChanges, PBKDF2 password hashing, a two-level cache over IMemoryCache/IDistributedCache, the system-clock provider, and DI auto-registration.</Description>
  </PropertyGroup>

  <!-- NuGet package metadata for the single It.D4np.Util package. The package <Version> is inherited from
       the single <Version> in Directory.Build.props (#48); bump it there in the release PR, in lockstep with
       the README badge (enforced by tools/consistency_lint.py). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>It.D4np.Util</PackageId>
    <Authors>Daniel Polo</Authors>
    <Product>egl-util-csharp</Product>
    <PackageDescription>Strongly-typed DDD, Clean Architecture, CQRS and functional Result building blocks for .NET 8: entities, value objects, aggregates, the Result/Error model, repository/specification/unit-of-work, an in-memory event broker, PBKDF2 password hashing, and a two-level cache. (MediatR/FluentValidation integration is the opt-in It.D4np.Util.MediatR package.)</PackageDescription>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Daniel Polo</Copyright>
    <PackageProjectUrl>https://github.com/danielPoloWork/egl-util-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/danielPoloWork/egl-util-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ddd;clean-architecture;cqrs;result;repository;specification;mediator;validation;caching;dotnet</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Package validation (#64), enabled at the 2.0 cut. No PackageValidationBaselineVersion yet: 2.0.0 is
         the first major that can serve as an API-compat baseline (a 1.0.0 baseline would fail on the
         intended 2.0 breaking changes, and 2.0.0 is not published while it is being built). Set
         PackageValidationBaselineVersion=2.0.0 in the first post-2.0.0 change so 2.0.x is validated
         against 2.0.0. Enabled now, it still runs the baseline-free framework/consistency validators. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectsInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Bundle the (PrivateAssets=all) referenced project outputs — Domain and Application, plus their
       XML docs and PDBs — into the package's build output alongside Infrastructure. pack filters
       BuildOutputInPackage by extension: the .dll/.xml go into the nupkg's lib folder, while the .pdb items
       go into the .snupkg symbol package. Without the .pdb line the snupkg shipped only Infrastructure's
       PDB, leaving Domain and Application permanently undebuggable via the symbol server (#66). -->
  <Target Name="IncludeReferencedProjectsInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_ReferencedProjectDll Include="@(ReferenceCopyLocalPaths)"
                             Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' And '%(Extension)' == '.dll'" />
      <BuildOutputInPackage Include="@(_ReferencedProjectDll)" />
      <BuildOutputInPackage Include="@(_ReferencedProjectDll->'%(RootDir)%(Directory)%(Filename).xml')"
                            Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')" />
      <BuildOutputInPackage Include="@(_ReferencedProjectDll->'%(RootDir)%(Directory)%(Filename).pdb')"
                            Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
  </Target>

</Project>
