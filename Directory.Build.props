<Project>

  <!--
    Shared build governance for egl-util-csharp (EADOS Milestone 1).
    Applies to every project in the solution. Per the spec's non-functional requirements:
    nullable reference types on and treated as errors, Roslyn analyzers enabled, deterministic
    builds, and a committed NuGet lockfile.
  -->
  <PropertyGroup>
    <!-- Absolute path to the repository root (this file's directory), for paths like the packaged README. -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!--
      Single source of truth for the library version (#48). Applied to EVERY assembly, so the SDK stamps
      AssemblyVersion/FileVersion/AssemblyInformationalVersion from it and `LibraryVersion.Version` (in the
      Domain assembly) can resolve it at runtime (#86). The packable project inherits it as its NuGet
      <Version>. Bump here in the release PR, in lockstep with the README `Status` badge (enforced by
      tools/consistency_lint.py). See ADR-0030.
    -->
    <Version>1.0.0</Version>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      Supply-chain guard (issue #23): in CI, restore in locked mode so a drifted or tampered
      transitive dependency fails the build instead of silently rewriting a committed
      packages.lock.json. Set once here, it applies to EVERY restore in EVERY CI job (build,
      quality, release, and any future job), including the implicit restore inside a build or
      test, and cannot be forgotten when a job is added. Local restores stay unlocked so
      developers can add or update packages and commit the regenerated lockfile in the same PR
      (see docs/development/local-build.md). See ADR-0014.
    -->
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

</Project>
