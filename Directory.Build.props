<Project>

  <!--
    Shared build governance for egl-util-csharp (EADOS Milestone 1).
    Applies to every project in the solution. Per the spec's non-functional requirements:
    nullable reference types on and treated as errors, Roslyn analyzers enabled, deterministic
    builds, and a committed NuGet lockfile.
  -->
  <PropertyGroup>
    <!-- Absolute path to the repository root (this file's directory), for paths like the packaged README. -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!--
      Single source of truth for the library version (#48). Applied to EVERY assembly, so the SDK stamps
      AssemblyVersion/FileVersion/AssemblyInformationalVersion from it and `LibraryVersion.Version` (in the
      Domain assembly) can resolve it at runtime (#86). The packable project inherits it as its NuGet
      <Version>. Bump here in the release PR, in lockstep with the README `Status` badge (enforced by
      tools/consistency_lint.py). See ADR-0030.
    -->
    <Version>1.0.0</Version>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      Make the advertised analyzer gate real (#77): AnalysisMode=Recommended turns on the recommended
      Roslyn CA rule set (not just the small default subset), and EnforceCodeStyleInBuild runs the IDExxxx
      style rules at build (at their .editorconfig severity) so `dotnet build -warnaserror` enforces them.
      Scoped to the shipped library (non-*Tests projects): test code follows looser, idiomatic conventions
      (xUnit underscore method names, inline test data) that these rules would flag as noise.
    -->
    <AnalysisMode Condition="!$(MSBuildProjectName.EndsWith('Tests'))">Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild Condition="!$(MSBuildProjectName.EndsWith('Tests'))">true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!--
      SourceLink + symbol settings (#36), applied to every project so the bundled Domain and Application
      PDBs carry a source-link document too (not just Infrastructure). Portable PDBs are emitted as separate
      files (required for the .snupkg); the repository URL is published into each PDB and untracked sources
      are embedded, so a consumer with symbol servers enabled can fetch the exact source. ContinuousIntegration
      Build (set on CI above) normalizes source paths for deterministic, server-resolvable symbols.
    -->
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      Supply-chain guard (issue #23): in CI, restore in locked mode so a drifted or tampered
      transitive dependency fails the build instead of silently rewriting a committed
      packages.lock.json. Set once here, it applies to EVERY restore in EVERY CI job (build,
      quality, release, and any future job), including the implicit restore inside a build or
      test, and cannot be forgotten when a job is added. Local restores stay unlocked so
      developers can add or update packages and commit the regenerated lockfile in the same PR
      (see docs/development/local-build.md). See ADR-0014.
    -->
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <!--
      SourceLink for GitHub (#36): embeds the repository URL + commit into every PDB so a symbol server can
      resolve the exact source. Build-time only (PrivateAssets=all) — it is not a runtime/package dependency.
      Applied here (all projects) so the package's bundled Domain and Application PDBs are source-linked too.
    -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
