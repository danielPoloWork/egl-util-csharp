# Deterministic line endings across platforms: Git stores and checks out text files as LF,
# overriding any local core.autocrlf so the CI `dotnet format` end-of-line gate is stable on
# the Linux runner. Matches the repo's LF-on-disk convention.
* text=auto eol=lf

# Binaries Git must never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.snk  binary
*.dll  binary
*.pdb  binary
